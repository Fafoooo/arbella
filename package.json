{
  "name": "arbella",
  "version": "0.2.0",
  "description": "Set up your AI coding tools once, then rebuild that setup on any machine. Claude Code, Codex, Cursor, opencode, GitHub Copilot CLI, Kilo Code & Antigravity — Linux, macOS, Windows.",
  "type": "module",
  "license": "AGPL-3.0-only",
  "author": "Fafoooo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Fafoooo/arbella.git"
  },
  "bugs": {
    "url": "https://github.com/Fafoooo/arbella/issues"
  },
  "homepage": "https://github.com/Fafoooo/arbella#readme",
  "keywords": [
    "claude-code",
    "codex",
    "cursor",
    "opencode",
    "github-copilot",
    "kilo-code",
    "antigravity",
    "backup",
    "migration",
    "cli",
    "dotfiles",
    "ai"
  ],
  "bin": {
    "arbella": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsup",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "dev": "tsx src/index.ts",
    "prepack": "npm run build",
    "prepublishOnly": "npm run typecheck && npm run test"
  },
  "dependencies": {
    "@clack/prompts": "^0.7.0",
    "commander": "^12.1.0",
    "execa": "^9.5.1",
    "picocolors": "^1.1.1",
    "smol-toml": "^1.3.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3",
    "vitest": "^2.1.5"
  }
}
